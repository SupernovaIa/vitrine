---
import Base from "../layouts/Base.astro";
import ItemCard from "../components/ItemCard.astro";
import Filters from "../components/Filters.astro";
import StatStrip from "../components/StatStrip.astro";
import { allItems, canon, statsOf } from "../lib/media";

const items = await allItems();
const stats = statsOf(items);
/* The featured row is tier S, not "in progress": with real data only one thing
   is ever mid-flight, and a one-card hero row reads as a bug. The S list is the
   most interesting thing a personal tracker holds anyway. */
const best = canon(items);
---

<Base title="vitrine — todo lo que veo, leo y juego">
  <section class="page hero">
    <h1>Todo lo que veo,<br />leo y juego.</h1>
    <p class="hero__lead prose">
      Un solo sitio para las cuatro cosas, porque la gracia está en verlas juntas:
      qué terminé, qué me marcó y qué llevo años posponiendo.
    </p>
    <StatStrip stats={stats} />
  </section>

  {
    best.length > 0 && (
      <section class="page section">
        <header class="section__head">
          <h2>Tier S</h2>
          <p class="kicker">{best.length} imprescindibles</p>
        </header>
        {/* A destination, not a preview: larger tiles, and room for the one
            sentence that says why it earned an S. Deliberately unnumbered —
            ranking inside a tier would invent an order that was never made. */}
        <div class="grid grid--canon">
          {best.map((item, i) => (
            <ItemCard item={item} width={240} eager={i < 6} claim />
          ))}
        </div>
      </section>
    )
  }

  <section class="page section">
    <header class="section__head">
      <h2>La estantería</h2>
      <p class="kicker" aria-live="polite">
        <span data-shelf-count>{items.length}</span> de {items.length}
      </p>
    </header>

    <Filters items={items} />

    <div class="grid grid--shelf" data-shelf>
      {items.map((item) => <ItemCard item={item} width={180} />)}
      <div class="grid__empty">
        <p class="prose">Nada con esos filtros.</p>
        <button class="grid__clear" type="button" data-clear-filters>Quitar filtros</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-7);
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero h1 {
    font-size: var(--text-display);
    max-width: 18ch;
  }

  .hero__lead {
    margin: 0;
    max-width: 52ch;
  }

  .hero :global(.stats) {
    width: 100%;
    margin-top: var(--space-3);
  }

  .section {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-5);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .section__head h2 {
    font-size: var(--text-lg);
  }

  .section__head p {
    margin: 0;
  }

  .grid {
    display: grid;
    /* auto-fill with a min keeps the poster width honest at every viewport
       instead of squeezing a fixed column count down to postage stamps. */
    gap: var(--space-5) var(--space-4);
  }

  .grid--canon {
    grid-template-columns: repeat(auto-fill, minmax(208px, 1fr));
    gap: var(--space-6) var(--space-5);
    align-items: start;
  }

  .grid--shelf {
    /* 132px was too tight once the covers had to carry their own titles: long
       book names had nowhere to wrap. */
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }

  .grid__empty {
    display: none;
    grid-column: 1 / -1;
    justify-items: start;
    gap: var(--space-4);
    color: var(--fg-subtle);
  }

  .grid.is-empty .grid__empty {
    display: grid;
  }

  .grid__empty p {
    margin: 0;
  }

  .grid__clear {
    min-height: 44px;
    padding: 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    cursor: pointer;
  }

  @media (max-width: 620px) {
    /* auto-fill drops the canon row to a single column on a phone, which blows
       one poster up to full width. Two is the floor. */
    .grid--canon {
      grid-template-columns: repeat(2, 1fr);
      /* Match the shelf's gutter: a wider one made the canon tiles *narrower*
         than the archive tiles they are supposed to lead. */
      gap: var(--space-5) var(--space-4);
    }
  }
</style>
