---
import Cover from "./Cover.astro";
import Tier from "./Tier.astro";
import {
  accentOf,
  progressOf,
  tierOf,
  undecided,
  type Item,
} from "../lib/media";

interface Props {
  item: Item;
  eager?: boolean;
  /** Rendered width of the tile, passed through so Astro emits the right image. */
  width?: number;
  /**
   * Shows the one-line verdict under the tile. Only the canon row asks for it:
   * the archive tiles stay identical in height so the wall reads as a grid.
   */
  claim?: boolean;
}

const { item, eager = false, width = 240, claim = false } = Astro.props;
const { data } = item;
const progress = progressOf(item);
const queued = data.status === "pending";
const tier = tierOf(item);
---

<a
  class="card"
  class:list={{ "card--queued": queued }}
  href={item.url}
  data-medium={item.medium}
  data-status={data.status}
  style={`--item-accent: ${accentOf(item)}`}
>
  <div class="card__poster">
    <Cover item={item} width={width} eager={eager} />

    {
      (tier || undecided(item)) && (
        <span class="card__tier">
          <Tier tier={tier} undecided={undecided(item)} />
        </span>
      )
    }


    {
      /* Progress reads as a bar on the poster edge rather than a number in the
         metadata: it is the one thing you scan a shelf for. */
      progress != null && (
        <span class="card__progress" role="presentation">
          <span class="card__progress-fill" style={`width: ${progress * 100}%`} />
        </span>
      )
    }
  </div>

  {claim && data.hook && <p class="card__claim">{data.hook}</p>}
</a>

<style>
  .card {
    display: block;
  }

  /* The author's own sentence about the thing. Serif, because it is a claim and
     not metadata — and it is the only copy on the shelf that is not a title. */
  .card__claim {
    margin: var(--space-3) 0 0;
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .card__poster {
    position: relative;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-poster);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  /* Lift plus a glow in the item's own colour. The ring is drawn as an inset
     shadow on a wrapper so it never nudges layout on hover. */
  .card:hover .card__poster,
  .card:focus-visible .card__poster {
    transform: translateY(-4px);
    box-shadow:
      var(--shadow-lift),
      0 0 0 1px color-mix(in oklab, var(--item-accent) 55%, transparent),
      0 14px 44px -10px color-mix(in oklab, var(--item-accent) 40%, transparent);
  }

  .card:focus-visible {
    outline: none;
  }

  .card:focus-visible .card__poster {
    outline: 2px solid var(--item-accent);
    outline-offset: 3px;
  }

  /* Queued things are dimmed so the shelf splits into "lived" and "waiting"
     without needing a second grid or a label on every tile. */
  .card--queued .card__poster {
    opacity: 0.52;
    filter: saturate(0.7);
    transition:
      opacity var(--dur) var(--ease),
      filter var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  /* The focus twin matters as much as the hover one: without it a keyboard user
     got a crisp accent ring around text still sitting at 0.52 opacity. */
  .card--queued:hover .card__poster,
  .card--queued:focus-visible .card__poster {
    opacity: 1;
    filter: none;
  }

  .card__tier {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    line-height: 0;
  }

  .card__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--track);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    overflow: hidden;
  }

  .card__progress-fill {
    display: block;
    height: 100%;
    background: var(--item-accent);
  }

</style>
