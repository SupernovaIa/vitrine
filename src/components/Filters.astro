---
import { MEDIA, STATUS, TIERS, tierOf, undecided, type Item } from "../lib/media";

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const mediums = (["films", "series", "books", "games"] as const).filter((m) =>
  items.some((i) => i.medium === m),
);
/* Order mirrors the shelf's own sort: finished, in flight, waiting, abandoned.
   Only states that actually occur get a chip. */
const statuses = (["done", "active", "pending", "dropped"] as const).filter((s) =>
  items.some((i) => i.data.status === s),
);
/* The verdict was the one axis with no control: the shelf holds 55 rated things
   and it took scrolling 73 tiles to find the good ones.

   Same rule as the rows above — a value that occurs in nothing gets no chip. It
   earns its keep here: "por decidir" is a state the schema allows and the data
   has none of, because every untiered entry is still pending. A chip for it
   would sit at zero, permanently disabled. It appears by itself the day
   something is finished without a verdict. */
const tiers = (["S", "A", "B", "C", "D"] as const).filter((t) =>
  items.some((i) => tierOf(i) === t),
);
const anyUndecided = items.some((i) => undecided(i));
---

<div class="filters" data-filters>
  <div class="filters__row" role="group" aria-label="Filtrar por medio">
    <button class="chip" data-facet="medium" data-value="" aria-pressed="true">
      Todo <span class="chip__count mono" data-count></span>
    </button>
    {
      mediums.map((m) => (
        <button
          class="chip"
          data-facet="medium"
          data-value={m}
          aria-pressed="false"
          style={`--chip-accent: var(--medium-${m})`}
        >
          <span class="chip__glyph" aria-hidden="true">
            {MEDIA[m].glyph}
          </span>
          {MEDIA[m].label} <span class="chip__count mono" data-count />
        </button>
      ))
    }
  </div>

  <div class="filters__row" role="group" aria-label="Filtrar por estado">
    <button class="chip chip--quiet" data-facet="status" data-value="" aria-pressed="true">
      Cualquier estado <span class="chip__count mono" data-count></span>
    </button>
    {
      statuses.map((s) => (
        <button class="chip chip--quiet" data-facet="status" data-value={s} aria-pressed="false">
          {STATUS[s].label} <span class="chip__count mono" data-count />
        </button>
      ))
    }
  </div>

  <div class="filters__row" role="group" aria-label="Filtrar por tier">
    <button class="chip chip--quiet" data-facet="tier" data-value="" aria-pressed="true">
      Cualquier tier <span class="chip__count mono" data-count></span>
    </button>
    {
      /* The letter, not the label: "S · A · B · C · D" reads as a scale where six
         chips reading "Imprescindible", "Muy bueno"… would only read as a queue,
         and would not fit a phone. The words are still there for anyone hovering
         or listening. */
      tiers.map((t) => (
        <button
          class="chip chip--quiet chip--tier"
          data-facet="tier"
          data-value={t}
          aria-pressed="false"
          aria-label={`Tier ${t}: ${TIERS[t].label}`}
          title={TIERS[t].label}
        >
          <span class="chip__tier mono">{t}</span>
          <span class="chip__count mono" data-count />
        </button>
      ))
    }
    {
      anyUndecided && (
        <button class="chip chip--quiet" data-facet="tier" data-value="undecided" aria-pressed="false">
          Por decidir <span class="chip__count mono" data-count />
        </button>
      )
    }
  </div>
</div>

<script>
  /* Filtering is a handful of class toggles over a few hundred nodes, so it runs
     without a framework and without a round trip. The unfiltered grid is in the
     HTML, which means it still works with JS off — the chips are the only thing
     that stops.

     Three things beyond hiding cards, all of which were missing:
       - every chip carries the count it would yield, and disables itself at zero,
         so the combinations that lead nowhere stop being reachable dead ends;
       - the count is announced, because 73 items used to vanish in silence;
       - the selection lives in the URL, so a filtered view can be shared and
         survives the browser's back button. */
  const root = document.querySelector<HTMLElement>("[data-filters]");
  const grid = document.querySelector<HTMLElement>("[data-shelf]");

  if (root && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-medium]"));
    const counter = document.querySelector<HTMLElement>("[data-shelf-count]");
    const clear = document.querySelector<HTMLElement>("[data-clear-filters]");
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-facet]"));

    /* Keyed by facet, not spelled out per facet: the two-argument version had
       every facet's name written into matches(), countFor(), the per-chip count
       and the reset, so adding the verdict meant editing five places and the
       count silently kept comparing against one facet instead of the others. */
    const PARAM = { medium: "medio", status: "estado", tier: "tier" } as const;
    const FACETS = Object.keys(PARAM) as (keyof typeof PARAM)[];
    const selected: Record<string, string> = { medium: "", status: "", tier: "" };

    const matches = (card: HTMLElement, sel: Record<string, string>) =>
      FACETS.every((f) => !sel[f] || card.dataset[f] === sel[f]);

    const countFor = (sel: Record<string, string>) =>
      cards.reduce((n, c) => n + (matches(c, sel) ? 1 : 0), 0);

    const apply = ({ push = true } = {}) => {
      let shown = 0;
      for (const card of cards) {
        const ok = matches(card, selected);
        card.classList.toggle("is-hidden", !ok);
        if (ok) shown++;
      }
      if (counter) counter.textContent = String(shown);
      grid.classList.toggle("is-empty", shown === 0);

      /* Each chip is counted against the other facets' current selection, so the
         number describes what clicking it would actually give you — its own facet
         is replaced, never intersected with itself. */
      for (const chip of chips) {
        const facet = chip.dataset.facet!;
        const value = chip.dataset.value ?? "";
        const n = countFor({ ...selected, [facet]: value });
        const slot = chip.querySelector<HTMLElement>("[data-count]");
        if (slot) slot.textContent = String(n);
        const isSelected = selected[facet] === value;
        chip.disabled = n === 0 && !isSelected;
        chip.setAttribute("aria-pressed", String(isSelected));
      }

      if (push) {
        const url = new URL(location.href);
        for (const [facet, param] of Object.entries(PARAM)) {
          if (selected[facet]) url.searchParams.set(param, selected[facet]);
          else url.searchParams.delete(param);
        }
        history.replaceState(null, "", url);
      }
    };

    root.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-facet]");
      if (!button || button.disabled) return;
      selected[button.dataset.facet!] = button.dataset.value ?? "";
      apply();
    });

    clear?.addEventListener("click", () => {
      for (const f of FACETS) selected[f] = "";
      apply();
      root.querySelector<HTMLButtonElement>('[data-facet="medium"][data-value=""]')?.focus();
    });

    /* Restore from the URL before the first paint of the counts. */
    const params = new URLSearchParams(location.search);
    for (const [facet, param] of Object.entries(PARAM)) {
      const v = params.get(param);
      if (v && chips.some((c) => c.dataset.facet === facet && c.dataset.value === v)) {
        selected[facet] = v;
      }
    }
    apply({ push: false });
  }
</script>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
  }

  .filters__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .chip:hover:not(:disabled) {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .chip[aria-pressed="true"] {
    color: var(--fg);
    border-color: color-mix(in oklab, var(--chip-accent, var(--accent)) 60%, transparent);
    background: color-mix(in oklab, var(--chip-accent, var(--accent)) 12%, var(--surface));
  }

  /* A combination that yields nothing stops being clickable rather than leading
     somewhere empty. */
  .chip:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .chip__glyph {
    color: var(--chip-accent, var(--accent));
    font-size: var(--text-xs);
  }

  .chip__count {
    font-size: var(--text-mono-xs);
    color: var(--fg-subtle);
  }

  .chip[aria-pressed="true"] .chip__count {
    color: var(--fg-muted);
  }

  .chip--quiet {
    font-size: var(--text-xs);
    /* Same 44px target; the visible mark is smaller, the hit area is not. */
    padding: 0 var(--space-3);
    background: transparent;
  }

  /* A single letter has to carry what a word carries in the other rows, so it
     gets the weight back that chip--quiet takes away. */
  .chip__tier {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-muted);
  }

  .chip[aria-pressed="true"] .chip__tier {
    color: var(--fg);
  }
</style>
