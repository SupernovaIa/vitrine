---
import { Image } from "astro:assets";
import { MEDIA, accentOf, progressLabel, type Item } from "../lib/media";

interface Props {
  item: Item;
  /** Rendered width in CSS pixels, so Astro emits the right candidates. */
  width?: number;
  eager?: boolean;
  /**
   * Whether the tile names itself. False where a heading already does — the
   * detail page printed title, author and year twice, 200px apart, on 72 of 73
   * entries.
   */
  caption?: boolean;
}

const { item, width = 240, eager = false, caption = true } = Astro.props;
const cover = item.data.cover;
const medium = MEDIA[item.medium];
/* Folded into the year line rather than captioned below the tile, so a card in
   progress is exactly as tall as every other card. */
const progress = progressLabel(item);
---

{/*
  One tile, whether or not artwork exists. Both states carry their own title in
  the same place, so a real cover does not become the odd card out — for a long
  time most entries will have none, and the grid has to read as finished either
  way. A missing cover is a first-class state: a typographic title card reads as
  a decision, a broken-image glyph reads as a bug.
*/}
<div
  class="cover"
  class:list={{ "cover--art": Boolean(cover), "cover--blank": !cover }}
  style={`--item-accent: ${accentOf(item)}`}
>
  {
    cover && (
      <Image
        class="cover__img"
        src={cover}
        alt={`Portada de ${item.data.title}`}
        widths={[width, width * 2]}
        sizes={`${width}px`}
        loading={eager ? "eager" : "lazy"}
      />
    )
  }

  <span class="cover__glyph" aria-hidden="true">{medium.glyph}</span>

  {
    caption && (
      /* One bottom-anchored block, so a missing author or year cannot move the
         title: the 15 imported series carry no creator and 7 books no year. */
      <span class="cover__foot" title={item.data.title}>
        {item.data.by && <span class="cover__by mono">{item.data.by}</span>}
        <span class="cover__title">{item.data.title}</span>
        {(item.data.year || progress) && (
          <span class="cover__year mono">
            {[item.data.year, progress].filter(Boolean).join(" · ")}
          </span>
        )}
      </span>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    width: 100%;
    /* Sources disagree on ratio — TMDB gives 2:3, IGDB nearer 3:4, book scans
       anything at all. Cropping to one shape costs ~10% of a game cover and
       buys a grid whose tiles line up. */
    aspect-ratio: var(--poster);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-inset);
    /* Lets the type scale to the tile instead of overflowing narrow columns. */
    container-type: inline-size;
  }

  .cover__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover--blank {
    /* The medium's accent, pulled almost all the way down to the surface: enough
       to tell the media apart at a glance, not enough to compete with real art. */
    background:
      linear-gradient(
        168deg,
        color-mix(in oklab, var(--item-accent) 22%, var(--surface)) 0%,
        var(--surface-inset) 78%
      );
    border: 1px solid color-mix(in oklab, var(--item-accent) 20%, var(--border));
  }

  /* Artwork needs its own ground under the type. Sized to the foot block rather
     than half the tile, so the picture stays the subject. */
  .cover--art::after {
    content: "";
    position: absolute;
    inset: 38% 0 0;
    /* Opaque enough by 62% that the foot reads over *any* artwork, not just the
       dark covers. A bright poster under a light scrim put the 11.5px author
       line near 3.6:1; this keeps the worst case above 8:1. The cost is a
       heavier veil over the bottom third, which is the trade every poster with
       an overlaid title makes. */
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--scrim-soft) 34%,
      var(--scrim-strong) 62%,
      var(--scrim-solid) 100%
    );
    pointer-events: none;
  }

  .cover__glyph {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 1;
    color: var(--item-accent);
    font-size: var(--text-lg);
    line-height: 1;
    opacity: 0.9;
  }

  /*
    Over artwork the glyph gets its own ground instead of a text-shadow. It sits
    in the top corner, where the foot scrim does not reach, so it was measured at
    1.00:1 on a white book cover — a white mark on white paper — and 2.55:1 on a
    cyan one. Veiling the top of the poster to fix it would need ~65% opacity
    over the art; a 20px chip costs nothing and pairs with the tier badge in the
    opposite corner. On this ground the same mark measures above 11:1.
  */
  .cover--art .cover__glyph {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    font-size: var(--text-sm);
    color: #fff;
    opacity: 1;
    background: var(--scrim-strong);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.5);
  }

  /* Anchored to the bottom of the tile: everything above is breathing room, so
     the title sits in the same place on every card, artwork or not. */
  .cover__foot {
    position: absolute;
    z-index: 1;
    inset: auto var(--space-4) var(--space-4);
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .cover__by {
    /* Data, not artwork: a fixed floor instead of a container-query scale.
       5.5cqw of a 150px shelf column resolved to 8.25px and bottomed out at the
       8.5px clamp minimum, on the only text 72 of 73 cards carry. */
    font-size: var(--text-mono-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    /* Two lines of a long studio name, then ellipsis. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cover__title {
    font-family: var(--font-serif);
    /* Scaled to the tile and given five lines, because on a blank cover the
       title is the artwork: "Cómo hacer amigos e influir en las personas" has
       to land, not ellipsise. */
    font-size: clamp(13px, 11.5cqw, 22px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cover__year {
    font-size: var(--text-mono-xs);
    color: var(--fg-subtle);
  }

  /* On artwork the type sits on a scrim, so it reads from white rather than from
     the muted tokens that were tuned for the flat tile. */
  .cover--art .cover__by,
  .cover--art .cover__year {
    color: var(--fg-on-art);
  }

  .cover--art .cover__title {
    color: #fff;
  }
</style>
